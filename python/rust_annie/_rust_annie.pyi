from typing import Callable, Dict, Optional, Sequence, Tuple, Union

import numpy as np
import numpy.typing as npt

__version__: str

ArrayLike = npt.ArrayLike
IdArray = npt.NDArray[np.int64]
DistArray = npt.NDArray[np.float32]
FilterLike = Union["Filter", Callable[[int], bool], None]

class Distance:
    EUCLIDEAN: "Distance"
    COSINE: "Distance"
    MANHATTAN: "Distance"
    CHEBYSHEV: "Distance"
    HAMMING: "Distance"
    JACCARD: "Distance"
    ANGULAR: "Distance"
    CANBERRA: "Distance"
    def __init__(self, name: str) -> None: ...
    @staticmethod
    def Minkowski(p: float) -> "Distance": ...
    @staticmethod
    def custom(name: str) -> "Distance": ...
    def name(self) -> str: ...

class Filter:
    @staticmethod
    def id_range(min: int, max: int) -> "Filter": ...
    @staticmethod
    def id_set(ids: Sequence[int]) -> "Filter": ...
    @staticmethod
    def boolean(bits: Sequence[bool]) -> "Filter": ...
    @staticmethod
    def and_(filters: Sequence["Filter"]) -> "Filter": ...
    @staticmethod
    def or_(filters: Sequence["Filter"]) -> "Filter": ...
    @staticmethod
    def not_(filter: "Filter") -> "Filter": ...
    def accepts(self, id: int, index: int) -> bool: ...

class AnnIndex:
    metric: Distance
    def __init__(self, dim: int, metric: Distance = ...) -> None: ...
    @staticmethod
    def new_minkowski(dim: int, p: float) -> "AnnIndex": ...
    @staticmethod
    def new_with_metric(dim: int, metric_name: str) -> "AnnIndex": ...
    def add(self, data: ArrayLike, ids: ArrayLike) -> None: ...
    def add_batch_with_progress(
        self,
        data: ArrayLike,
        ids: ArrayLike,
        progress_callback: Callable[[int, int], object],
        chunk_size: int = 10000,
    ) -> None: ...
    def search(self, query: ArrayLike, k: int, filter: FilterLike = None) -> Tuple[IdArray, DistArray]: ...
    def search_batch(
        self, queries: ArrayLike, k: int, filter: FilterLike = None
    ) -> Tuple[IdArray, DistArray]: ...
    def remove(self, ids: Sequence[int]) -> None: ...
    def update(self, id: int, vector: ArrayLike) -> None: ...
    def compact(self) -> None: ...
    def set_max_deleted_ratio(self, ratio: float) -> None: ...
    def ids(self) -> IdArray: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> "AnnIndex": ...
    def len(self) -> int: ...
    def __len__(self) -> int: ...
    def __contains__(self, id: int) -> bool: ...
    def capacity(self) -> int: ...
    def deleted_count(self) -> int: ...
    def version(self) -> int: ...
    def dim(self) -> int: ...
    def enable_metrics(self, port: Optional[int] = None) -> None: ...
    def get_metrics(self) -> Optional[Dict[str, object]]: ...
    def update_recall_estimate(self, k: int, recall: float) -> None: ...
    def get_info(self) -> Dict[str, str]: ...
    def validate(self) -> None: ...

class ThreadSafeAnnIndex:
    @property
    def metric(self) -> Distance: ...
    def __init__(self, dim: int, metric: Distance = ...) -> None: ...
    def add(self, data: ArrayLike, ids: ArrayLike) -> None: ...
    def search(self, query: ArrayLike, k: int, filter: FilterLike = None) -> Tuple[IdArray, DistArray]: ...
    def search_batch(
        self, queries: ArrayLike, k: int, filter: FilterLike = None
    ) -> Tuple[IdArray, DistArray]: ...
    def remove(self, ids: Sequence[int]) -> None: ...
    def update(self, id: int, vector: ArrayLike) -> None: ...
    def compact(self) -> None: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> "ThreadSafeAnnIndex": ...
    def set_max_deleted_ratio(self, ratio: float) -> None: ...
    def ids(self) -> IdArray: ...
    def capacity(self) -> int: ...
    def deleted_count(self) -> int: ...
    def get_info(self) -> Dict[str, str]: ...
    def validate(self) -> None: ...
    def version(self) -> int: ...
    def len(self) -> int: ...
    def __len__(self) -> int: ...
    def __contains__(self, id: int) -> bool: ...
    def dim(self) -> int: ...

class HnswConfig:
    m: int
    ef_construction: int
    ef_search: int
    max_elements: int
    def __init__(
        self, m: int = 16, ef_construction: int = 200, ef_search: int = 50, max_elements: int = 10000
    ) -> None: ...
    @staticmethod
    def default() -> "HnswConfig": ...
    def validate(self) -> None: ...

class PyHnswIndex:
    ef_search: int
    metric: Distance
    config: HnswConfig
    def __init__(
        self,
        dims: int,
        metric: Distance = ...,
        m: int = 16,
        ef_construction: int = 200,
        ef_search: int = 50,
        max_elements: int = 10000,
        config: Optional[HnswConfig] = None,
    ) -> None: ...
    def add(self, data: ArrayLike, ids: ArrayLike) -> None: ...
    def search(
        self, query: ArrayLike, k: int, ef: Optional[int] = None, filter: FilterLike = None
    ) -> Tuple[IdArray, DistArray]: ...
    def search_batch(
        self, queries: ArrayLike, k: int, ef: Optional[int] = None, filter: FilterLike = None
    ) -> Tuple[IdArray, DistArray]: ...
    def remove(self, ids: Sequence[int]) -> None: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> "PyHnswIndex": ...
    def dims(self) -> int: ...
    def len(self) -> int: ...
    def __len__(self) -> int: ...
    def __contains__(self, id: int) -> bool: ...
    def get_info(self) -> Dict[str, str]: ...
    def validate(self) -> None: ...

class Index:
    kind: str
    def __init__(self, kind: str, dim: int, metric: Distance = ...) -> None: ...
    def add(self, data: ArrayLike, ids: ArrayLike) -> None: ...
    def search(self, query: ArrayLike, k: int, filter: FilterLike = None) -> Tuple[IdArray, DistArray]: ...
    def search_batch(
        self, queries: ArrayLike, k: int, filter: FilterLike = None
    ) -> Tuple[IdArray, DistArray]: ...
    def remove(self, ids: Sequence[int]) -> None: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> "Index": ...
    def __len__(self) -> int: ...
    def get_info(self) -> Dict[str, str]: ...
    def validate(self) -> None: ...

class PyMetricsCollector:
    def __init__(self) -> None: ...
    def enable_metrics(self, port: int) -> None: ...
    def get_metrics(self) -> Dict[str, object]: ...
    def get_prometheus_metrics(self) -> str: ...

def register_metric(name: str, func: Callable[[np.ndarray, np.ndarray], float]) -> None: ...
def list_metrics() -> list[str]: ...
